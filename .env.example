# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Clerk (auth) ---
# https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# https://dashboard.clerk.com -> your app -> Webhooks -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Neon (Postgres) ---
# https://console.neon.tech -> your project -> Connection Details (use the pooled connection string)
DATABASE_URL=

# --- Cloudflare R2 (object storage) ---
# https://dash.cloudflare.com -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket dev URL or your own custom domain, no trailing slash
R2_PUBLIC_BASE_URL=

# --- Upstash Redis (rate limiting) ---
# https://console.upstash.com -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
