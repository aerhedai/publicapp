# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# _DEV-suffixed variables are optional local bookkeeping for a separate set
# of dev-only resources (see README "Branches and environments") - only the
# unsuffixed names are actually read by the app at runtime.

# --- Clerk (auth) ---
# https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# https://dashboard.clerk.com -> your app -> Webhooks -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Neon (Postgres) ---
# https://console.neon.tech -> your project -> Connection Details (use the pooled connection string)
DATABASE_URL=

# --- Cloudflare R2 (object storage) ---
# https://dash.cloudflare.com -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket dev URL or your own custom domain, no trailing slash
R2_PUBLIC_BASE_URL=

# --- Upstash Redis (rate limiting + global dispatch concurrency) ---
# https://console.upstash.com -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- RunPod (GPU job dispatch) ---
# https://console.runpod.io/user/settings -> API Keys. Server-only, never NEXT_PUBLIC_.
RUNPOD_API_KEY=
# https://console.runpod.io/serverless -> your endpoint -> the id in its URL/overview.
# Two separate endpoints, one per job type - video (MiniMax H3, big GPU) and
# image (Flux2, lighter) are never dispatched to the same worker pool.
RUNPOD_ENDPOINT_ID_VIDEO=
RUNPOD_ENDPOINT_ID_IMAGE=
# A secret this app mints itself (e.g. `openssl rand -hex 32`) - appended as a
# query param on the webhook URL given to RunPod's /run, verified on receipt
# in POST /api/webhooks/runpod via crypto.timingSafeEqual.
RUNPOD_WEBHOOK_SECRET=
# Global ceiling on simultaneous RunPod dispatches, checked in src/lib/concurrency.ts -
# should roughly match the endpoint's own configured max-workers.
RUNPOD_MAX_CONCURRENT_JOBS=2

# --- OpenRouter (chat controller) ---
# https://openrouter.ai/settings/keys. Server-only, never NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Same model the local pipeline already uses for this exact job (structured
# single-JSON-object extraction) - see pipeline/config.py. Optional, defaults
# to upstage/solar-pro4 if unset.
OPENROUTER_MODEL=

# --- Cron (Vercel Cron auth) ---
# A secret this app mints itself - Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# --- App base URL (used to build the RunPod webhook callback URL) ---
# Only needed if you want a stable value instead of relying on Vercel's own
# auto-provided VERCEL_URL at runtime (see src/lib/runpod.ts).
APP_BASE_URL=
